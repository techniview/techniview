# Copy to .env and change values. Compose reads .env automatically.
# Defaults below match the original scaffolding values.

MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DB=app_db

# Host ports, container ports stay fixed
GO_JUDGE_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=5173
MYSQL_HOST_PORT=3306

# Number of sandbox execution slots and application worker processes.
GO_JUDGE_PARALLELISM=16
DIRECT_WORKER_PROCESSES=4
