# Copy to .env and change values. Compose reads .env automatically.
# Defaults below match the original scaffolding values.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=test_password
POSTGRES_DB=postgres

REDIS_PASSWORD=test_password

MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DB=app_db

# Host ports, container ports stay fixed
JUDGE0_PORT=2358
BACKEND_PORT=8000
FRONTEND_PORT=5173
MYSQL_HOST_PORT=3306
