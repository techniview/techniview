# Copy to .env and change values. Compose reads .env automatically.
# Local development defaults. Production has separate env examples.

MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DB=app_db

# Host ports, container ports stay fixed
GO_JUDGE_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=5173
MYSQL_HOST_PORT=3306

# Runner slots and CPU quota are separate limits.
GO_JUDGE_PARALLELISM=16
RUNNER_CPU_LIMIT=24
# Four replicas with four processes each provide 16 application worker processes.
APP_WORKER_REPLICAS=4
DIRECT_WORKER_PROCESSES=4
