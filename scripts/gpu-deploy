#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
env_file=${TECHNIVIEW_ENV_FILE:-.env.production}
runner_image=$(<go-judge/runner-image.ref)
export GO_JUDGE_IMAGE=$runner_image
compose=(docker compose --env-file "$env_file" -f compose.production.yml)
command=${1:-help}

usage() {
  cat <<'EOF'
Usage: scripts/gpu-deploy {init|doctor|deploy|warm-ollama|status|logs|down|mail}
  init     Create the environment and secrets if missing; start and seed demo accounts.
  doctor   Check Docker access, Compose configuration, and local app route.
  deploy   Build app images from this checkout and start the GPU stack.
  warm-ollama Load the configured model and keep it resident for ten minutes.
  status   Show service health.
  logs     Follow service logs (optionally pass service names).
  down     Stop services without deleting persistent data.
  mail     List captured email messages from the latest worker container.
EOF
}

init_env() {
  if [[ ! -e $env_file ]]; then
    cp .env.production.example "$env_file"
    chmod 600 "$env_file"
  fi
  chmod 600 "$env_file"
  if grep -q '^GRAFANA_ADMIN_PASSWORD=replace-' "$env_file"; then
    local grafana_password
    grafana_password=$(openssl rand -hex 32)
    sed -i "s|^GRAFANA_ADMIN_PASSWORD=.*|GRAFANA_ADMIN_PASSWORD=$grafana_password|" "$env_file"
  fi
}

prepare() {
  local secrets="$HOME/.local/share/techniview/secrets"
  mkdir -p -m 700 "$secrets"
  for name in mysql_root_password mysql_password email_signing_key resend_api_key; do
    if [[ ! -e "$secrets/$name" ]]; then
      case $name in
        mysql_root_password|mysql_password|email_signing_key) openssl rand -hex 32 > "$secrets/$name" ;;
        resend_api_key) : > "$secrets/$name" ;;
      esac
      chmod 400 "$secrets/$name"
    fi
  done
  if grep -q '^EMAIL_DELIVERY_MODE=resend$' "$env_file" && [[ ! -s "$secrets/resend_api_key" ]]; then
    echo 'Resend mode requires a nonempty resend_api_key secret.' >&2
    exit 1
  fi
  chmod 700 "$secrets"
  bash scripts/prepare-docker-volumes.sh "$secrets"
}

check_local_route() {
  local frontend_address
  frontend_address=$("${compose[@]}" port frontend 80 2>/dev/null || true)
  if [[ -n $frontend_address ]] && curl --fail --silent "http://$frontend_address/techniview/" >/dev/null; then
    echo 'Local app route responds.'
  else
    echo 'Local app route is not responding; check frontend status and logs.' >&2
    exit 1
  fi
}

check_ollama() {
  local ollama_url
  ollama_url=$("${compose[@]}" exec -T complexity_worker printenv BIG_O_OLLAMA_URL)
  if [[ -n $ollama_url ]]; then
    "${compose[@]}" exec -T complexity_worker python -m scripts.ollama_check
  else
    echo 'AI complexity estimates disabled (BIG_O_OLLAMA_URL is empty).'
  fi
}

warm_ollama() {
  local ollama_url
  ollama_url=$("${compose[@]}" exec -T complexity_worker printenv BIG_O_OLLAMA_URL)
  if [[ -n $ollama_url ]]; then
    "${compose[@]}" exec -T complexity_worker python -m scripts.ollama_check --warm
  else
    echo 'AI complexity estimates disabled (BIG_O_OLLAMA_URL is empty).'
  fi
}

ensure_ollama_proxy() {
  if ! grep -q '^BIG_O_OLLAMA_URL=http://host.docker.internal:11435$' "$env_file"; then
    return
  fi
  if docker inspect techniview-ollama-proxy >/dev/null 2>&1; then
    if [[ $(docker inspect -f '{{.State.Running}}' techniview-ollama-proxy) == true ]]; then
      return
    fi
    docker rm techniview-ollama-proxy >/dev/null
  fi
  docker run -d --name techniview-ollama-proxy \
    --restart unless-stopped --network host \
    --read-only --cap-drop ALL --security-opt no-new-privileges \
    alpine/socat \
    TCP-LISTEN:11435,bind=172.17.0.1,reuseaddr,fork \
    TCP:127.0.0.1:11434 >/dev/null
}

remove_ollama_proxy() {
  if docker inspect techniview-ollama-proxy >/dev/null 2>&1; then
    docker rm -f techniview-ollama-proxy >/dev/null
  fi
}

case $command in
  init)
    init_env
    if grep -q '^PUBLIC_HOST=techniview.example.edu$' "$env_file"; then
      echo "Set PUBLIC_HOST in $env_file before initializing." >&2
      exit 1
    fi
    prepare
    "${compose[@]}" config -q
    ensure_ollama_proxy
    "${compose[@]}" up -d --build --wait
    check_local_route
    warm_ollama
    "${compose[@]}" exec -T backend python -m app.seed
    echo 'GPU deployment is ready. Demo accounts: teacher@techniview.local / teacher-demo; student@techniview.local / student-demo.'
    ;;
  doctor)
    [[ -f $env_file ]] || { echo "Missing $env_file; run init." >&2; exit 1; }
    docker info >/dev/null
    "${compose[@]}" config -q
    check_local_route
    warm_ollama
    ;;
  deploy)
    [[ -f $env_file ]] || { echo "Missing $env_file; run init." >&2; exit 1; }
    prepare
    "${compose[@]}" config -q
    ensure_ollama_proxy
    "${compose[@]}" up -d --build --wait
    check_local_route
    check_ollama
    ;;
  warm-ollama)
    [[ -f $env_file ]] || { echo "Missing $env_file; run init." >&2; exit 1; }
    warm_ollama
    ;;
  status) "${compose[@]}" ps ;;
  logs) shift; "${compose[@]}" logs -f "$@" ;;
  down)
    "${compose[@]}" down
    remove_ollama_proxy
    ;;
  mail) "${compose[@]}" exec -T app_worker sh -c 'for f in /tmp/techniview-mail/*.json; do [ -f "$f" ] && cat "$f"; done' ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
