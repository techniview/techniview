# Runner VM only. Store as .env.runner.production with mode 0600.
RUNNER_PRIVATE_BIND_IP=10.20.30.42
GO_JUDGE_IMAGE=ghcr.io/techniview/techniview/go-judge@sha256:digest-from-go-judge/runner-image.ref
GO_JUDGE_PARALLELISM=16
# A CPU quota for the runner container, separate from its 16 execution slots.
RUNNER_CPU_LIMIT=24
JUDGE_WORKER_MEMORY_LIMIT=8G
