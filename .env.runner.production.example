# Runner VM only. Store as .env.runner.production with mode 0600.
# Bind the Judge0 API only to the app-to-runner private network.
RUNNER_PRIVATE_BIND_IP=10.20.30.42
SECRET_DIR=/etc/techniview-runner/secrets
IMAGE_NAMESPACE=ghcr.io/techniview/techniview
IMAGE_TAG=replace-with-reviewed-release-commit-sha
POSTGRES_USER=judge0
POSTGRES_DB=judge0

# Adjust only after the assignment-load test and runner VM sizing are agreed.
JUDGE0_WORKER_COUNT=4
JUDGE0_MAX_QUEUE_SIZE=250
JUDGE_WORKER_MEMORY_LIMIT=8G
