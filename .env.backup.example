# Install as /etc/techniview/backup.env with mode 0600.
TECHNIVIEW_APP_ENV_FILE=/etc/techniview/.env.production
TECHNIVIEW_COMPOSE_FILE=/opt/techniview/current/compose.production.yml

# Use an encrypted restic repository on campus backup storage.
RESTIC_REPOSITORY=sftp:backup@example.edu:/srv/backups/techniview
RESTIC_PASSWORD_FILE=/etc/techniview/restic-password
