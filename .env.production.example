# Application VM only. Store as .env.production with mode 0600.
PUBLIC_HOST=techniview.example.edu
RUNNER_PRIVATE_HOST=10.20.30.42
SECRET_DIR=/etc/techniview/secrets
IMAGE_NAMESPACE=ghcr.io/techniview/techniview
IMAGE_TAG=replace-with-reviewed-release-commit-sha

# Increase after load testing against the allocated application VM.
APP_WORKER_REPLICAS=4
DIRECT_WORKER_PROCESSES=4
API_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Grafana is available on localhost:3000 through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password

MYSQL_USER=techniview
MYSQL_DB=techniview

EMAIL_FROM=TechniView <noreply@example.edu>
