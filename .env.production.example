# GPU host. Copy to .env.production; scripts/gpu-deploy sets mode 0600.
PUBLIC_HOST=techniview.example.edu
# The frontend listens behind the GPU host's HTTPS proxy.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
# Execution slots and runner CPU quota are independent ceilings.
GO_JUDGE_PARALLELISM=16
RUNNER_CPU_LIMIT=24
JUDGE_WORKER_MEMORY_LIMIT=8G

# Four replicas with four processes each provide 16 application worker processes.
APP_WORKER_REPLICAS=4
DIRECT_WORKER_PROCESSES=4
COMPLEXITY_WORKER_REPLICAS=1
API_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Grafana is available on localhost:3000 through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password

MYSQL_USER=techniview
MYSQL_DB=techniview

EMAIL_FROM=TechniView <noreply@example.edu>
# Captured mail works without Resend; switch to resend after configuring it.
EMAIL_DELIVERY_MODE=capture

# Optional AI complexity estimates. Leave the URL empty until Ollama is reachable
# from Docker containers. Ollama commonly listens on port 11434.
BIG_O_OLLAMA_URL=
BIG_O_OLLAMA_MODEL=qwen3.8:27b
BIG_O_OLLAMA_TIMEOUT_SECONDS=90
BIG_O_ANALYSIS_MAX_ATTEMPTS=3
