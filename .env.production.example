# Application VM only. Store as .env.production with mode 0600.
PUBLIC_HOST=techniview.example.edu
# The frontend listens behind the GPU host's HTTPS proxy.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
# Use go-judge with compose.gpu.yml, or a private IP with a separate runner host.
RUNNER_PRIVATE_HOST=10.20.30.42
# Required when using compose.gpu.yml. Copy the digest from go-judge/runner-image.ref.
GO_JUDGE_IMAGE=replace-with-pinned-go-judge-image-ref
GO_JUDGE_PARALLELISM=16
RUNNER_CPU_LIMIT=24
JUDGE_WORKER_MEMORY_LIMIT=8G
SECRET_DIR=${HOME}/.local/share/techniview/secrets
IMAGE_NAMESPACE=ghcr.io/techniview/techniview
IMAGE_TAG=replace-with-reviewed-release-commit-sha

# Four replicas with four processes each provide 16 application worker processes.
APP_WORKER_REPLICAS=4
DIRECT_WORKER_PROCESSES=4
COMPLEXITY_WORKER_REPLICAS=1
API_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Grafana is available on localhost:3000 through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password

MYSQL_USER=techniview
MYSQL_DB=techniview

EMAIL_FROM=TechniView <noreply@example.edu>
# Use capture for a private smoke test before Resend is configured.
EMAIL_DELIVERY_MODE=resend
