{
  "id": null,
  "uid": "techniview-operations",
  "title": "TechniView operations",
  "tags": ["techniview", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API metrics scrape health",
      "description": "A healthy scrape means the API metrics endpoint and its database queries are responding.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"techniview-api\"}", "legendFormat": "API", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request latency, p95",
      "description": "Five minute p95 across API routes. The metrics route is excluded.",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(techniview_http_request_duration_seconds_bucket{route!=\"/api/metrics\"}[5m])))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Submission queue",
      "description": "Queued submission count and age of the oldest queued submission.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "techniview_submission_queue_depth", "legendFormat": "Depth", "refId": "A" },
        { "expr": "techniview_submission_queue_oldest_seconds", "legendFormat": "Oldest age", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [{ "matcher": { "id": "byName", "options": "Oldest age" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Execution cases by phase",
      "description": "Current active case counts by dispatch and runner phase.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "techniview_execution_cases{phase!=\"total\"}", "legendFormat": "{{phase}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Submission completion rate",
      "description": "Submissions completed per minute, averaged over a rolling five minute window.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "techniview_submission_completion_rate_per_minute", "legendFormat": "completions/min", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Runner failures and retries",
      "description": "Persisted runner overloads, unknown outcomes, dispatch retries, and poll failures.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "techniview_runner_busy_submissions", "legendFormat": "runner busy", "refId": "A" },
        { "expr": "techniview_runner_unknown_outcomes", "legendFormat": "unknown outcome", "refId": "B" },
        { "expr": "techniview_runner_dispatch_retries", "legendFormat": "dispatch retries", "refId": "C" },
        { "expr": "techniview_runner_poll_failures", "legendFormat": "poll failures", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    }
  ],
  "links": []
}
